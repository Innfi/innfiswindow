{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/preload/index.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/components/**/*",
    "src/renderer/lib/**/*",
    "src/renderer/store/**/*",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@components/*": ["src/renderer/components/*"],
      "@lib/*": ["src/renderer/lib/*"],
      "@store/*": ["src/renderer/store/*"]
    }
  }
}
