{
  "name": "innfiswindow",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "package": "npm run build && electron-builder",
    "package:unpack": "npm run build && electron-builder --dir",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test --config e2e/playwright.config.ts",
    "dep:check": "depcruise src",
    "dep:graph": "depcruise src --output-type mermaid --exclude \"node_modules|^(fs|path|http|net|child_process|os|url|crypto|util|stream|events)$\" --collapse \"^src/(main/(handlers|ipc)|preload|renderer/src/(components|hooks|types)|renderer/(components/ui|lib|store))\"",
    "dep:html": "depcruise src --output-type err-html --output-to dependency-report.html",
    "dep:svg": "depcruise src --output-type dot --exclude \"node_modules|^(fs|path|http|net|child_process|os|url|crypto|util|stream|events)$\" | dot -T svg -o dependency-graph.svg",
    "dep:svg:archi": "depcruise src --output-type archi --exclude \"node_modules|^(fs|path|http|net|child_process|os|url|crypto|util|stream|events)$\" | dot -T svg -o dependency-graph-archi.svg"
  },
  "lint-staged": {
    "*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@kubernetes/client-node": "^1.4.0",
    "@monaco-editor/react": "^4.6.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-virtual": "^3.14.6",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "bufferutil": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.577.0",
    "monaco-editor": "^0.52.0",
    "prometheus-query": "^3.5.1",
    "recharts": "^2.15.3",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tar-fs": "^3.1.3",
    "utf-8-validate": "^6.0.6",
    "ws": "^8.19.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@playwright/test": "^1.49.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/tar-fs": "^2.0.4",
    "@vitejs/plugin-react": "^4.3.1",
    "dependency-cruiser": "^18.1.0",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "lint-staged": "^17.2.0",
    "prettier": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^2.0.0"
  }
}
